{
  "openapi": "3.0.0",
  "info": {
    "title": "Property API",
    "version": "1.0.0",
    "description": "Production-ready RESTful Real Estate API with Enterprise Security Best Practices"
  },
  "servers": [
    {
      "url": "http://localhost:5000/v1",
      "description": "Local Development Server (Port 5000)"
    },
    {
      "url": "http://localhost:6000/v1",
      "description": "Local Development Server (Port 6000)"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "message": { "type": "string" },
          "data": { "type": "object" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "message": { "type": "string" },
          "errors": { "type": "array", "items": { "type": "object" } }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email", "example": "user@example.com" },
          "password": { "type": "string", "example": "Password123!" }
        }
      },
      "CreateUserRequest": {
        "type": "object",
        "required": ["email", "password", "name"],
        "properties": {
          "name": { "type": "string", "example": "John Doe" },
          "email": { "type": "string", "format": "email", "example": "johndoe@example.com" },
          "password": { "type": "string", "example": "SecurePass123!" },
          "role": { "type": "string", "enum": ["user", "agent", "merchant", "admin"], "default": "user" },
          "phone": { "type": "string", "example": "+1234567890" }
        }
      },
      "CreatePropertyRequest": {
        "type": "object",
        "required": ["title", "description", "price", "location", "propertyType"],
        "properties": {
          "title": { "type": "string", "example": "Modern 3 Bedroom Apartment" },
          "description": { "type": "string", "example": "Spacious apartment located in downtown." },
          "price": { "type": "number", "example": 250000 },
          "propertyType": { "type": "string", "example": "apartment" },
          "location": {
            "type": "object",
            "properties": {
              "address": { "type": "string", "example": "123 Main Street" },
              "city": { "type": "string", "example": "Metropolis" },
              "state": { "type": "string", "example": "NY" }
            }
          },
          "bedrooms": { "type": "integer", "example": 3 },
          "bathrooms": { "type": "integer", "example": 2 },
          "images": { "type": "array", "items": { "type": "string" } }
        }
      },
      "CreateAppointmentRequest": {
        "type": "object",
        "required": ["property_id", "appointment_date"],
        "properties": {
          "property_id": { "type": "string", "example": "60d5ec49f1b2c811845e2111" },
          "appointment_date": { "type": "string", "format": "date-time", "example": "2026-08-01T10:00:00.000Z" },
          "notes": { "type": "string", "example": "Interested in morning viewing" }
        }
      },
      "CreateReviewRequest": {
        "type": "object",
        "required": ["property_id", "rating", "comment"],
        "properties": {
          "property_id": { "type": "string", "example": "60d5ec49f1b2c811845e2111" },
          "rating": { "type": "integer", "minimum": 1, "maximum": 5, "example": 5 },
          "comment": { "type": "string", "example": "Great location and wonderful neighborhood!" }
        }
      },
      "CreateWishlistRequest": {
        "type": "object",
        "required": ["property_id"],
        "properties": {
          "property_id": { "type": "string", "example": "60d5ec49f1b2c811845e2111" }
        }
      },
      "Notification": {
        "type": "object",
        "properties": {
          "_id": { "type": "string", "example": "60d5ec49f1b2c811845e9999" },
          "recipientId": { "type": "string", "example": "60d5ec49f1b2c811845e2111" },
          "guestSessionId": { "type": "string", "example": "guest-session-456" },
          "recipientRole": { "type": "string", "enum": ["guest", "user", "agent", "merchant", "admin"], "example": "user" },
          "actorRole": { "type": "string", "enum": ["guest", "user", "agent", "merchant", "admin", "system"], "example": "system" },
          "triggeredByUserId": { "type": "string", "example": "60d5ec49f1b2c811845e2111" },
          "sourceType": { "type": "string", "enum": ["property", "inquiry", "offer", "showing", "lease", "system"], "example": "showing" },
          "sourceId": { "type": "string", "example": "60d5ec49f1b2c811845e3333" },
          "type": { "type": "string", "example": "showing_request" },
          "category": { "type": "string", "enum": ["engagement", "management", "sales", "system", "compliance"], "example": "management" },
          "priority": { "type": "string", "enum": ["low", "medium", "high", "critical"], "example": "medium" },
          "title": { "type": "string", "example": "New Showing Request" },
          "message": { "type": "string", "example": "A tour request has been made." },
          "isRead": { "type": "boolean", "example": false },
          "readAt": { "type": "string", "format": "date-time" },
          "isArchived": { "type": "boolean", "example": false },
          "channels": {
            "type": "object",
            "properties": {
              "inApp": { "type": "boolean", "example": true },
              "email": { "type": "boolean", "example": false },
              "push": { "type": "boolean", "example": false },
              "sms": { "type": "boolean", "example": false }
            }
          },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "NotificationPreference": {
        "type": "object",
        "properties": {
          "_id": { "type": "string", "example": "60d5ec49f1b2c811845e8888" },
          "userId": { "type": "string", "example": "60d5ec49f1b2c811845e2111" },
          "guestSessionId": { "type": "string", "example": "guest-session-456" },
          "channels": {
            "type": "object",
            "properties": {
              "inApp": { "type": "boolean", "default": true },
              "email": { "type": "boolean", "default": true },
              "push": { "type": "boolean", "default": true },
              "sms": { "type": "boolean", "default": false }
            }
          },
          "categories": {
            "type": "object",
            "properties": {
              "engagement": { "type": "boolean", "default": true },
              "management": { "type": "boolean", "default": true },
              "sales": { "type": "boolean", "default": true },
              "system": { "type": "boolean", "default": true },
              "compliance": { "type": "boolean", "default": true }
            }
          },
          "quietHours": {
            "type": "object",
            "properties": {
              "enabled": { "type": "boolean", "default": false },
              "start": { "type": "string", "default": "22:00" },
              "end": { "type": "string", "default": "07:00" },
              "timezone": { "type": "string", "default": "UTC" }
            }
          },
          "digestFrequency": { "type": "string", "enum": ["instant", "daily", "weekly"], "default": "instant" }
        }
      },
      "UpdatePreferencesRequest": {
        "type": "object",
        "properties": {
          "channels": {
            "type": "object",
            "properties": {
              "inApp": { "type": "boolean" },
              "email": { "type": "boolean" },
              "push": { "type": "boolean" },
              "sms": { "type": "boolean" }
            }
          },
          "categories": {
            "type": "object",
            "properties": {
              "engagement": { "type": "boolean" },
              "management": { "type": "boolean" },
              "sales": { "type": "boolean" },
              "system": { "type": "boolean" },
              "compliance": { "type": "boolean" }
            }
          },
          "quietHours": {
            "type": "object",
            "properties": {
              "enabled": { "type": "boolean" },
              "start": { "type": "string", "example": "22:00" },
              "end": { "type": "string", "example": "07:00" },
              "timezone": { "type": "string", "example": "UTC" }
            }
          },
          "digestFrequency": { "type": "string", "enum": ["instant", "daily", "weekly"] }
        }
      },
      "BroadcastNotificationRequest": {
        "type": "object",
        "required": ["recipientRoles", "title", "message"],
        "properties": {
          "recipientRoles": {
            "type": "array",
            "items": { "type": "string" },
            "example": ["user", "agent"]
          },
          "title": { "type": "string", "example": "System Maintenance Notice" },
          "message": { "type": "string", "example": "The platform will undergo scheduled maintenance." },
          "priority": { "type": "string", "enum": ["low", "medium", "high", "critical"], "default": "medium" },
          "data": { "type": "object" },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "url"],
              "properties": {
                "label": { "type": "string" },
                "url": { "type": "string" },
                "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"], "default": "GET" }
              }
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "User Login",
        "description": "Authenticate user credentials and receive JWT access token",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Login successful" },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/token": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Create Token",
        "security": [],
        "responses": {
          "200": { "description": "Token generated successfully" }
        }
      }
    },
    "/properties": {
      "get": {
        "tags": ["Properties"],
        "summary": "Get All Properties",
        "description": "Retrieve property listings with optional search, sorting, and pagination filters",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 10 } },
          { "name": "city", "in": "query", "schema": { "type": "string" } },
          { "name": "minPrice", "in": "query", "schema": { "type": "number" } },
          { "name": "maxPrice", "in": "query", "schema": { "type": "number" } }
        ],
        "responses": {
          "200": { "description": "Properties retrieved successfully" }
        }
      },
      "post": {
        "tags": ["Properties"],
        "summary": "Create Property Listing",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreatePropertyRequest" }
            }
          }
        },
        "responses": {
          "201": { "description": "Property created successfully" }
        }
      }
    },
    "/properties/buy": {
      "post": {
        "tags": ["Properties"],
        "summary": "Purchase Property",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "property_id": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Purchase transaction initiated" }
        }
      }
    },
    "/properties/{property_id}": {
      "get": {
        "tags": ["Properties"],
        "summary": "Get Property Details",
        "parameters": [
          { "name": "property_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Property details retrieved" },
          "404": { "description": "Property not found" }
        }
      },
      "put": {
        "tags": ["Properties"],
        "summary": "Update Property Listing",
        "parameters": [
          { "name": "property_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreatePropertyRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Property updated successfully" }
        }
      },
      "delete": {
        "tags": ["Properties"],
        "summary": "Delete Property Listing",
        "parameters": [
          { "name": "property_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Property deleted successfully" }
        }
      }
    },
    "/properties/{property_id}/resource": {
      "put": {
        "tags": ["Properties"],
        "summary": "Update Property Resource / Upload Media",
        "parameters": [
          { "name": "property_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Property resource updated" }
        }
      }
    },
    "/properties/{property_id}/set-verified": {
      "put": {
        "tags": ["Properties"],
        "summary": "Verify Property Listing",
        "parameters": [
          { "name": "property_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Property verification status updated" }
        }
      }
    },
